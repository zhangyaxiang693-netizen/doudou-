{
  "id": "RichText",
  "name": "富文本",
  "category": "text",
  "width": 610,
  "height": 200,
  "props": [
    {
      "key": "content",
      "type": "text",
      "label": "文本内容",
      "default": "在此输入文本内容..."
    },
    {
      "key": "fontSize",
      "type": "select",
      "label": "字号",
      "options": [
        {
          "label": "标题",
          "value": "title"
        },
        {
          "label": "正文",
          "value": "body"
        }
      ],
      "default": "body"
    },
    {
      "key": "color",
      "type": "select",
      "label": "颜色",
      "options": [
        {
          "label": "黑色",
          "value": "black"
        },
        {
          "label": "灰色",
          "value": "gray"
        },
        {
          "label": "玫红色",
          "value": "rose"
        }
      ],
      "default": "black"
    },
    {
      "key": "bullet",
      "type": "boolean",
      "label": "项目符号",
      "default": false
    },
    {
      "key": "icon",
      "type": "boolean",
      "label": "标题图标",
      "default": false
    }
  ],
  "reactComponent": "RichText"
}
