{
  "title": "投放案例",
  "description": "展示行业投放策略、执行建议和关键数据的案例组件",
  "category": "service",
  "dimensions": {
    "width": 640,
    "height": 700
  },
  "props": [
    {
      "name": "categoryText",
      "label": "行业分类",
      "type": "text",
      "default": "服装配饰",
      "description": "案例所属行业"
    },
    {
      "name": "headlineText",
      "label": "案例标题",
      "type": "text",
      "default": "七夕驱动穿搭需求集中爆发",
      "description": "案例主标题"
    },
    {
      "name": "videoLabelText",
      "label": "视频内容标签",
      "type": "text",
      "default": "视频内容：",
      "description": "视频内容段落标签"
    },
    {
      "name": "videoDescriptionText",
      "label": "视频内容说明",
      "type": "text",
      "default": "视频建议做场景型/对比型/清单型/上身效果型，镜头须一眼看懂版型搭配，8/12起日更",
      "description": "视频内容建议正文"
    },
    {
      "name": "videoFrequencyText",
      "label": "视频日更数量",
      "type": "text",
      "default": "2-3",
      "description": "视频内容正文中的高亮日更数量"
    },
    {
      "name": "videoUnitText",
      "label": "视频数量单位",
      "type": "text",
      "default": "条",
      "description": "日更数量单位"
    },
    {
      "name": "placementLabelText",
      "label": "投放建议标签",
      "type": "text",
      "default": "投放建议：",
      "description": "投放建议段落标签"
    },
    {
      "name": "placementDescriptionText",
      "label": "投放建议说明",
      "type": "text",
      "default": "投放视频播放，8/19晚18-22点保留60%预算追投，剩余预算考虑前置推广，建议每单",
      "description": "投放建议正文"
    },
    {
      "name": "placementAmountText",
      "label": "建议单笔金额",
      "type": "text",
      "default": "100~300",
      "description": "投放建议正文中的高亮金额"
    },
    {
      "name": "placementUnitText",
      "label": "投放金额单位",
      "type": "text",
      "default": "元",
      "description": "建议单笔金额单位"
    },
    {
      "name": "executionLabelText",
      "label": "执行要点标签",
      "type": "text",
      "default": "执行要点：",
      "description": "执行要点段落标签"
    },
    {
      "name": "executionDescriptionText",
      "label": "执行要点说明",
      "type": "text",
      "default": "8/17起前置直播预告；评论区及时承接尺码与搭配咨询",
      "description": "执行要点正文"
    },
    {
      "name": "updateCaptionText",
      "label": "日更数据说明",
      "type": "text",
      "default": "8/12起视频日更",
      "description": "左侧关键数据说明"
    },
    {
      "name": "updateMinText",
      "label": "日更最小数量",
      "type": "text",
      "default": "2",
      "description": "日更区间最小值"
    },
    {
      "name": "rangeSeparatorText",
      "label": "日更区间符号",
      "type": "text",
      "default": "-",
      "description": "日更数量区间连接符"
    },
    {
      "name": "updateMaxText",
      "label": "日更最大数量",
      "type": "text",
      "default": "3",
      "description": "日更区间最大值"
    },
    {
      "name": "updateUnitText",
      "label": "日更数量单位",
      "type": "text",
      "default": "条",
      "description": "日更区间单位"
    },
    {
      "name": "budgetPercentText",
      "label": "追投预算比例",
      "type": "text",
      "default": "60",
      "description": "节点追投预算比例数值"
    },
    {
      "name": "percentUnitText",
      "label": "百分比符号",
      "type": "text",
      "default": "%",
      "description": "预算比例单位"
    },
    {
      "name": "budgetCaptionText",
      "label": "预算数据说明",
      "type": "text",
      "default": "节点预算追投",
      "description": "右侧关键数据说明"
    }
  ]
}
