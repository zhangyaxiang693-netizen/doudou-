{
  "name": "RedPacketCoupon",
  "title": "红包优惠券",
  "description": "红包样式的优惠券组件，包含金额、账户信息和使用按钮",
  "category": "营销组件",
  "props": [
    {
      "name": "prefix",
      "label": "前缀",
      "type": "string",
      "default": "DOU+",
      "description": "优惠券前缀标识（带描边效果）"
    },
    {
      "name": "title",
      "label": "标题",
      "type": "string",
      "default": "优惠券",
      "description": "优惠券标题文字"
    },
    {
      "name": "accountInfo",
      "label": "账户信息",
      "type": "string",
      "default": "账户内共有 2 张券",
      "description": "账户内优惠券数量提示文案"
    },
    {
      "name": "totalLabel",
      "label": "总计标签",
      "type": "string",
      "default": "总计",
      "description": "竖排显示的总计标签（支持2个字）"
    },
    {
      "name": "amount",
      "label": "金额",
      "type": "string",
      "default": "800",
      "description": "优惠券金额数字"
    },
    {
      "name": "unit",
      "label": "单位",
      "type": "string",
      "default": "元",
      "description": "金额单位"
    },
    {
      "name": "buttonText",
      "label": "按钮文字",
      "type": "string",
      "default": "立即使用",
      "description": "底部按钮文字"
    },
    {
      "name": "bgColor",
      "label": "背景色",
      "type": "color",
      "default": "#FF4693",
      "description": "红包背景主色"
    },
    {
      "name": "cardColor",
      "label": "卡片颜色",
      "type": "color",
      "default": "#FFFFFF",
      "description": "中间白色卡片颜色"
    },
    {
      "name": "decorStartColor",
      "label": "装饰色-起始",
      "type": "color",
      "default": "#FF3163",
      "description": "装饰图案渐变起始色（顶部）"
    },
    {
      "name": "decorEndColor",
      "label": "装饰色-结束",
      "type": "color",
      "default": "#FFD2DD",
      "description": "装饰图案渐变结束色（底部）"
    },
    {
      "name": "topStartColor",
      "label": "顶部色-底部",
      "type": "color",
      "default": "#FF277F",
      "description": "顶部封口渐变底部颜色"
    },
    {
      "name": "topEndColor",
      "label": "顶部色-顶部",
      "type": "color",
      "default": "#FF4F99",
      "description": "顶部封口渐变顶部颜色"
    },
    {
      "name": "dotColor",
      "label": "虚线颜色",
      "type": "color",
      "default": "#FFCFD7",
      "description": "中间分割虚线点颜色"
    },
    {
      "name": "btnBgColor",
      "label": "按钮背景色",
      "type": "color",
      "default": "#FFDBB2",
      "description": "按钮背景颜色"
    },
    {
      "name": "btnTextColor",
      "label": "按钮文字颜色",
      "type": "color",
      "default": "#FF2C5C",
      "description": "按钮上文字的颜色"
    },
    {
      "name": "prefixFontFamily",
      "label": "前缀-字体",
      "type": "string",
      "default": "\"Douyin Sans\"",
      "description": "前缀文字的字体"
    },
    {
      "name": "prefixFontSize",
      "label": "前缀-字号",
      "type": "string",
      "default": "44",
      "description": "前缀文字的字号"
    },
    {
      "name": "prefixColor",
      "label": "前缀-颜色",
      "type": "color",
      "default": "#3D3D3D",
      "description": "前缀文字的颜色"
    },
    {
      "name": "prefixLetterSpacing",
      "label": "前缀-字间距",
      "type": "string",
      "default": "-3.12",
      "description": "前缀文字的字间距"
    },
    {
      "name": "titleFontFamily",
      "label": "标题-字体",
      "type": "string",
      "default": "\"Source Han Sans CN\"",
      "description": "标题文字的字体"
    },
    {
      "name": "titleFontSize",
      "label": "标题-字号",
      "type": "string",
      "default": "40",
      "description": "标题文字的字号"
    },
    {
      "name": "titleColor",
      "label": "标题-颜色",
      "type": "color",
      "default": "#3D3D3D",
      "description": "标题文字的颜色"
    },
    {
      "name": "titleLetterSpacing",
      "label": "标题-字间距",
      "type": "string",
      "default": "0",
      "description": "标题文字的字间距"
    },
    {
      "name": "accountInfoFontFamily",
      "label": "账户信息-字体",
      "type": "string",
      "default": "\"Source Han Sans CN\"",
      "description": "账户信息文字的字体"
    },
    {
      "name": "accountInfoFontSize",
      "label": "账户信息-字号",
      "type": "string",
      "default": "24",
      "description": "账户信息文字的字号"
    },
    {
      "name": "accountInfoColor",
      "label": "账户信息-颜色",
      "type": "color",
      "default": "#3D3D3D",
      "description": "账户信息文字的颜色"
    },
    {
      "name": "accountInfoLetterSpacing",
      "label": "账户信息-字间距",
      "type": "string",
      "default": "0",
      "description": "账户信息文字的字间距"
    },
    {
      "name": "totalLabelFontFamily",
      "label": "总计标签-字体",
      "type": "string",
      "default": "\"Source Han Sans CN\"",
      "description": "总计标签文字的字体"
    },
    {
      "name": "totalLabelFontSize",
      "label": "总计标签-字号",
      "type": "string",
      "default": "22",
      "description": "总计标签文字的字号"
    },
    {
      "name": "totalLabelColor",
      "label": "总计标签-颜色",
      "type": "color",
      "default": "#FF1372",
      "description": "总计标签文字的颜色"
    },
    {
      "name": "totalLabelLetterSpacing",
      "label": "总计标签-字间距",
      "type": "string",
      "default": "-1",
      "description": "总计标签文字的字间距"
    },
    {
      "name": "amountFontFamily",
      "label": "金额-字体",
      "type": "string",
      "default": "\"Douyin Number ABC\"",
      "description": "金额数字的字体"
    },
    {
      "name": "amountFontSize",
      "label": "金额-字号",
      "type": "string",
      "default": "76",
      "description": "金额数字的字号"
    },
    {
      "name": "amountColor",
      "label": "金额-颜色",
      "type": "color",
      "default": "#FF1372",
      "description": "金额数字的颜色"
    },
    {
      "name": "amountLetterSpacing",
      "label": "金额-字间距",
      "type": "string",
      "default": "-3.58",
      "description": "金额数字的字间距"
    },
    {
      "name": "unitFontFamily",
      "label": "单位-字体",
      "type": "string",
      "default": "\"Source Han Sans CN\"",
      "description": "单位文字的字体"
    },
    {
      "name": "unitFontSize",
      "label": "单位-字号",
      "type": "string",
      "default": "26",
      "description": "单位文字的字号"
    },
    {
      "name": "unitColor",
      "label": "单位-颜色",
      "type": "color",
      "default": "#3D3D3D",
      "description": "单位文字的颜色"
    },
    {
      "name": "unitLetterSpacing",
      "label": "单位-字间距",
      "type": "string",
      "default": "0",
      "description": "单位文字的字间距"
    },
    {
      "name": "buttonFontFamily",
      "label": "按钮文字-字体",
      "type": "string",
      "default": "\"Source Han Sans CN\"",
      "description": "按钮文字的字体"
    },
    {
      "name": "buttonFontSize",
      "label": "按钮文字-字号",
      "type": "string",
      "default": "40",
      "description": "按钮文字的字号"
    },
    {
      "name": "buttonLetterSpacing",
      "label": "按钮文字-字间距",
      "type": "string",
      "default": "0.04em",
      "description": "按钮文字的字间距"
    },
    {
      "name": "btnBorderRadius",
      "label": "按钮圆角",
      "type": "string",
      "default": "100",
      "description": "按钮的圆角大小"
    },
    {
      "name": "borderRadius",
      "label": "整体圆角",
      "type": "string",
      "default": "60",
      "description": "整体圆角大小，控制背景、卡片的四个角和顶部封口的底部两个角（共10个角）"
    },
    {
      "name": "className",
      "label": "CSS类名",
      "type": "string",
      "default": "",
      "description": "自定义CSS类名"
    }
  ]
}
