{
  "name": "h5-visual-builder",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env.local server/index.cjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test server/__tests__/*.test.cjs src/project-history/*.test.js src/collaboration/*.test.js src/traffic-coupon.test.js",
    "test:export": "npm run build && EXPORT_VISUAL_TESTS=1 node --test server/__tests__/export-font-layout.test.cjs server/__tests__/export-browser.test.cjs src/project-history/daily-header-title-layout.test.js",
    "export:check": "node scripts/server-export-preflight.cjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "sass": "^1.70.0",
    "vite": "^5.0.0"
  }
}
