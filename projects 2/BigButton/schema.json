{
  "name": "BigButton",
  "title": "大按钮",
  "description": "大号圆角按钮组件，红色渐变背景，白色文字",
  "category": "基础组件",
  "props": [
    {
      "name": "text",
      "label": "按钮文字",
      "type": "string",
      "default": "去投放",
      "description": "按钮上显示的文字"
    },
    {
      "name": "textFontFamily",
      "label": "文字字体",
      "type": "string",
      "default": "Source Han Sans CN",
      "description": "按钮文字的字体"
    },
    {
      "name": "textFontSize",
      "label": "文字字号",
      "type": "string",
      "default": "40",
      "description": "按钮文字的字号（单位px）"
    },
    {
      "name": "textLetterSpacing",
      "label": "文字间距",
      "type": "string",
      "default": "0",
      "description": "按钮文字之间的字间距（单位px）"
    },
    {
      "name": "textColor",
      "label": "文字颜色",
      "type": "string",
      "default": "#ffffff",
      "description": "按钮文字的纯色"
    },
    {
      "name": "textGradient",
      "label": "文字渐变色",
      "type": "string",
      "default": "",
      "description": "按钮文字的渐变色，优先级高于文字颜色"
    },
    {
      "name": "bgColor",
      "label": "背景颜色",
      "type": "string",
      "default": "",
      "description": "按钮背景的纯色，不传则使用默认渐变"
    },
    {
      "name": "bgGradient",
      "label": "背景渐变色",
      "type": "string",
      "default": "linear-gradient(73deg,rgba(255,20,115,1),rgba(255,34,159,1))",
      "description": "按钮背景的渐变色，优先级高于背景颜色"
    },
    {
      "name": "borderRadius",
      "label": "圆角大小",
      "type": "string",
      "default": "100",
      "description": "按钮的圆角大小（单位px）"
    },
    {
      "name": "paddingX",
      "label": "左右内边距",
      "type": "string",
      "default": "100",
      "description": "文字两侧到背景边缘的间距（单位px），按钮宽度会随文字自适应"
    },
    {
      "name": "buttonHeight",
      "label": "按钮高度",
      "type": "string",
      "default": "110",
      "description": "按钮的高度（单位px）"
    },
    {
      "name": "className",
      "label": "CSS类名",
      "type": "string",
      "default": "",
      "description": "自定义CSS类名"
    },
    {
      "name": "onClick",
      "label": "点击事件",
      "type": "function",
      "default": "",
      "description": "按钮点击回调函数"
    }
  ]
}
