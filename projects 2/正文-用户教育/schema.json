{
  "id": "正文-用户教育",
  "name": "正文-用户教育",
  "title": "正文-用户教育",
  "type": "atom",
  "category": "原子组件",
  "description": "用户教育正文组件，支持按段展示每段标题和正文。",
  "reactComponent": "正文-用户教育",
  "dimensions": {
    "width": 634,
    "height": 860
  },
  "heightMode": "auto",
  "minHeight": 180,
  "blueprint": {
    "autoExposeProps": true,
    "matchKeywords": [
      "正文-用户教育",
      "用户教育",
      "投放目标",
      "投放时长",
      "DOU+",
      "段落数量"
    ],
    "textProps": [
      "firstTitleText",
      "firstBodyText",
      "secondTitleText",
      "secondBodyText",
      "thirdTitleText",
      "thirdBodyText",
      "fourthTitleText",
      "fourthBodyText",
      "paragraphCount"
    ]
  },
  "props": [
    {
      "key": "firstTitleText",
      "name": "firstTitleText",
      "label": "第一段标题",
      "type": "string",
      "default": "投放什么目标？"
    },
    {
      "key": "firstBodyText",
      "name": "firstBodyText",
      "label": "第一段正文",
      "type": "text",
      "control": "textarea",
      "default": "需要提升点赞/评论/转化量, 可以选择「点赞评论量」\n需要更多视频播放量, 可以选择「视频播放量」\n需要粉丝量快速提升, 达成千粉可以选择「粉丝量」"
    },
    {
      "key": "secondTitleText",
      "name": "secondTitleText",
      "label": "第二段标题",
      "type": "string",
      "default": "如何选择投放时长?"
    },
    {
      "key": "secondBodyText",
      "name": "secondBodyText",
      "label": "第二段正文",
      "type": "text",
      "control": "textarea",
      "default": "优先建议24小时或者12小时投放, 可以匹配性价比最高流量, 建议预算不低于100元\n长期运营的账户, 可以拉长周期, 比如3天300元以上"
    },
    {
      "key": "thirdTitleText",
      "name": "thirdTitleText",
      "label": "第三段标题",
      "type": "string",
      "default": "什么作品适合投DOU+?"
    },
    {
      "key": "thirdBodyText",
      "name": "thirdBodyText",
      "label": "第三段正文",
      "type": "text",
      "control": "textarea",
      "default": "优选系统推荐视频, 如果账号下出现「潜力视频」等系统标签, 建议优先投放\n建议多视频投放, 系统会自动选择多个视频中投放效果好的加大预算投入"
    },
    {
      "key": "fourthTitleText",
      "name": "fourthTitleText",
      "label": "第四段标题",
      "type": "string",
      "default": "投放影响自然流量么?"
    },
    {
      "key": "fourthBodyText",
      "name": "fourthBodyText",
      "label": "第四段正文",
      "type": "text",
      "control": "textarea",
      "default": "DOU+付费流量与自然流量相互独立, 投放不会压制自然流量。优质数据反而可以协同带来更多自然流量。"
    },
    {
      "key": "paragraphCount",
      "name": "paragraphCount",
      "label": "段落数量",
      "type": "string",
      "default": "4",
      "description": "控制展示几段，可填 1、2、3 或 4。"
    }
  ]
}
