{
  "name": "BigDayCouponClassic",
  "title": "BigDay经典优惠券",
  "description": "BigDay经典优惠券组件，DOU+优惠券样式，带渐变模糊背景",
  "category": "营销组件",
  "props": [
    {
      "name": "amount",
      "label": "金额",
      "type": "string",
      "default": "800",
      "description": "优惠券金额数字"
    },
    {
      "name": "unit",
      "label": "单位",
      "type": "string",
      "default": "元",
      "description": "金额单位"
    },
    {
      "name": "expiry",
      "label": "有效期",
      "type": "string",
      "default": "仅剩 1 天使用",
      "description": "有效期提示文案"
    },
    {
      "name": "prefix",
      "label": "前缀",
      "type": "string",
      "default": "DOU+",
      "description": "带白色描边效果的前缀标识"
    },
    {
      "name": "title",
      "label": "标题",
      "type": "string",
      "default": "优惠券",
      "description": "优惠券标题文字"
    },
    {
      "name": "className",
      "label": "CSS类名",
      "type": "string",
      "default": "",
      "description": "自定义CSS类名"
    }
  ]
}