{
  "name": "SingleCoupon",
  "title": "单个优惠券",
  "description": "单个优惠券组件，包含标题、金额、单位和标签",
  "category": "营销组件",
  "props": [
    {
      "name": "title",
      "label": "标题",
      "type": "string",
      "default": "DOU+满赠券",
      "description": "优惠券的标题文字"
    },
    {
      "name": "amount",
      "label": "金额",
      "type": "string",
      "default": "800",
      "description": "优惠券的金额数值"
    },
    {
      "name": "unit",
      "label": "单位",
      "type": "string",
      "default": "元",
      "description": "金额的单位"
    },
    {
      "name": "tag",
      "label": "标签",
      "type": "string",
      "default": "叠加",
      "description": "优惠券的标签文字（如叠加、限量等）"
    },
    {
      "name": "radius",
      "label": "圆角",
      "type": "number",
      "default": 40,
      "min": 0,
      "max": 100,
      "description": "优惠券主体圆角，同时控制两个背景图层的圆角"
    },
    {
      "name": "bgGradientStart",
      "label": "背景渐变起始色",
      "type": "color",
      "uiType": "color",
      "default": "#FFF3F3",
      "description": "券背景的渐变起始颜色"
    },
    {
      "name": "bgGradientEnd",
      "label": "背景渐变结束色",
      "type": "color",
      "uiType": "color",
      "default": "#FFFEFE",
      "description": "券背景的渐变结束颜色"
    },
    {
      "name": "topGradientStart",
      "label": "顶部渐变起始色",
      "type": "color",
      "uiType": "color",
      "default": "#FF57AF",
      "description": "顶部粉色渐变的起始颜色"
    },
    {
      "name": "topGradientEnd",
      "label": "顶部渐变结束色",
      "type": "color",
      "uiType": "color",
      "default": "#FF387B",
      "description": "顶部粉色渐变的结束颜色"
    },
    {
      "name": "dividerColor",
      "label": "分割线颜色",
      "type": "color",
      "uiType": "color",
      "default": "#FFD2D2",
      "description": "虚线分割线的颜色"
    },
    {
      "name": "tagButtonColor",
      "label": "按钮颜色",
      "type": "color",
      "uiType": "color",
      "default": "rgba(255, 226, 99, 1)",
      "description": "叠加标签按钮的背景颜色"
    },
    {
      "name": "titleFontSize",
      "label": "标题字号",
      "type": "number",
      "default": 24,
      "description": "标题文字的字号"
    },
    {
      "name": "titleFontFamily",
      "label": "标题字体",
      "type": "string",
      "uiType": "font",
      "default": "Douyin Sans",
      "description": "标题文字的字体"
    },
    {
      "name": "titleLetterSpacing",
      "label": "标题字间距",
      "type": "number",
      "default": 0,
      "description": "标题文字的字间距"
    },
    {
      "name": "titleColor",
      "label": "标题字颜色",
      "type": "color",
      "uiType": "color",
      "default": "rgba(255, 255, 255, 1)",
      "description": "标题文字的颜色"
    },
    {
      "name": "amountFontSize",
      "label": "金额字号",
      "type": "number",
      "default": 63,
      "description": "金额文字的字号"
    },
    {
      "name": "amountFontFamily",
      "label": "金额字体",
      "type": "string",
      "uiType": "font",
      "default": "Douyin Number ABC",
      "description": "金额文字的字体"
    },
    {
      "name": "amountLetterSpacing",
      "label": "金额字间距",
      "type": "number",
      "default": -2.99,
      "description": "金额文字的字间距"
    },
    {
      "name": "amountColor",
      "label": "金额字颜色",
      "type": "color",
      "uiType": "color",
      "default": "rgba(61, 61, 61, 1)",
      "description": "金额文字的颜色"
    },
    {
      "name": "unitFontSize",
      "label": "单位字号",
      "type": "number",
      "default": 24,
      "description": "单位文字的字号"
    },
    {
      "name": "unitFontFamily",
      "label": "单位字体",
      "type": "string",
      "uiType": "font",
      "default": "Source Han Sans CN",
      "description": "单位文字的字体"
    },
    {
      "name": "unitLetterSpacing",
      "label": "单位字间距",
      "type": "number",
      "default": 0,
      "description": "单位文字的字间距"
    },
    {
      "name": "unitColor",
      "label": "单位字颜色",
      "type": "color",
      "uiType": "color",
      "default": "rgba(61, 61, 61, 1)",
      "description": "单位文字的颜色"
    },
    {
      "name": "tagFontSize",
      "label": "标签字号",
      "type": "number",
      "default": 22,
      "description": "标签文字的字号"
    },
    {
      "name": "tagFontFamily",
      "label": "标签字体",
      "type": "string",
      "uiType": "font",
      "default": "Source Han Sans CN",
      "description": "标签文字的字体"
    },
    {
      "name": "tagLetterSpacing",
      "label": "标签字间距",
      "type": "number",
      "default": 0,
      "description": "标签文字的字间距"
    },
    {
      "name": "tagColor",
      "label": "标签字颜色",
      "type": "color",
      "uiType": "color",
      "default": "rgba(97, 50, 24, 1)",
      "description": "标签文字的颜色"
    },
    {
      "name": "className",
      "label": "CSS类名",
      "type": "string",
      "default": "",
      "description": "自定义CSS类名"
    }
  ]
}
